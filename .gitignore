# Image files:
*.jpg
*.png

# Ubuntu auto-generated files:
.Trash-0/
*.trashinfo

# macOS auto-generated files:
*.DS_Store

# Python auto-generated files:
*.pyc

# User-specific environment overrides (created from a platform template in 'env/'):
.env.custom

# 'catkin build' auto-generated files (for all platforms):
ros/*_catkin_ws/CMakeLists.txt
ros/*_catkin_ws/.catkin_tools/
ros/*_catkin_ws/build/
ros/*_catkin_ws/devel/
ros/*_catkin_ws/logs/

# 'catkin_make' auto-generated files (for all platforms):
ros/*_catkin_ws/src/CMakeLists.txt
ros/*_catkin_ws/.catkin_workspace
ros/*_catkin_ws/install/

# 'rosbag' files:
*.bag

# Terminator 'config' files:
terminator/*.config.tmp

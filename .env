# This file contains the default environment-specific configuration variables.
# Do not modify this file directly as it serves as the baseline for environment variables.
# To customize or override any of these values, use the switch script to create a '.env.custom' file.
# The '.env.custom' file is sourced after the '.env' file and is ignored by Git.
#
# Usage: bash ./SWITCH-ROBOT-PLATFORM.bash <robot-platform>

################################################################################

# OpenRoSDE configuration.

# Platform to use, among those that 'bash ./SWITCH-ROBOT-PLATFORM.bash' lists when run without an argument.
OPENROSDE_ROBOT_PLATFORM=turtlebot3

# Setup to use, among those that 'bash ./SWITCH-ROBOT-SETUP.bash' lists when run without an argument.
# Note: The template of a platform is its default setup, named after the platform, and the template of any other setup declares its own name here.
OPENROSDE_ROBOT_SETUP=turtlebot3

# Root directory of the OpenRoSDE repository inside the Docker container.
# Note: This path is used by the Docker volume mount and all container scripts.
OPENROSDE_CONTAINER_ROOT_DIR=/root/OpenRoSDE

# Extensions to add beside the platform, as space-separated names of the folders cloned into 'extensions/', in the order their Catkin workspaces are built.
# Note: A platform that lives in an extension is found by its name, so its folder needs no entry here.
OPENROSDE_ROBOT_EXTENSIONS=

# Registry of the Docker images, where 'BUILD-DOCKER-IMAGE.bash' pulls the base and platform images from and the CI publishes them to.
OPENROSDE_DOCKER_REGISTRY=registry.gitlab.com/coarobo/sde

# Tag of the base and platform images in the registry, 'main' or 'dev', the only two the CI publishes and the registry keeps.
# Note: 'auto' picks 'main' on the 'main' branch, the release 'vX.Y.Z' on a checkout of that release tag, 'main' on any other detached checkout, and 'dev' on every other branch.
OPENROSDE_DOCKER_IMAGE_TAG=auto

# Images that 'BUILD-DOCKER-IMAGE.bash' builds locally when their pull fails: 'true' for the base and platform images, 'platform' for the platform image alone, such as a private platform that the registry does not hold, or 'false' for neither.
# Note: A CI job sets 'false' or 'platform' in '.env.custom', so that a failed pull fails the job rather than building the base image for hours.
OPENROSDE_DOCKER_BUILD_FALLBACK=true

# Leave out the list of every 'OPENROSDE_*' variable that the entry scripts print, with 'true', as a CI job does to keep its log short.
# Note: The value of a variable whose name holds 'PASSWORD', 'TOKEN', or 'SECRET' is never printed.
OPENROSDE_QUIET=false

################################################################################

# ROS configuration.

# Host name or IP address of the machine running the ROS master.
# Note: Usually the robot's host name or IP address if remote, or 'localhost' if local (e.g., when running a simulation on Gazebo).
OPENROSDE_ROS_MASTER_HOSTNAME=localhost

# IP address of the development machine (i.e., this machine running the container).
# Note: The container network is set to 'host' via Docker Compose to share the development machine's network interface.
OPENROSDE_ROS_CLIENT_IP=

# Robot hostname for automatic '/etc/hosts' resolution in the Docker container (optional).
# Note: Set to the robot's mDNS hostname (e.g., 'turtlebot3.local') for automatic network discovery via 'avahi-resolve'.
OPENROSDE_ROBOT_HOSTNAME=turtlebot3.local

################################################################################

# User overlay configuration.
# Override these in '.env.custom' to expose your own values to the user-devel container.
# These variables are interpolated by 'docker/docker-compose-user.yaml'.

# Example user-defined variable.
OPENROSDE_USER_EXAMPLE_VAR=user-example-value

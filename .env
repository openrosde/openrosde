# This file contains the default environment-specific configuration variables.
#
# Usage:
# - This '.env' file contains the default settings required for the SDE scripts.
# - Do not modify this file directly as it serves as the baseline for environment variables.
# - To customize or override any of these values, create a separate '.env.custom' file.
# - Ensure the '.env.custom' file is sourced after the '.env' file in your scripts or terminal session.
# - The '.env' file should remain unchanged to allow easy updates and consistency across environments.

################################################################################

# Platform to use: turtlebot3, ur5e
SDE_PLATFORM=turtlebot3

################################################################################

# ROS configuration.

# Host name or IP address of the machine running the ROS master.
# Note: Usually the robot's host name or IP address if remote, or 'localhost' if local (e.g., when running a simulation on Gazebo).
ENV_ROS_MASTER_HOSTNAME=localhost

# IP address of the development machine (i.e., this machine running the container).
# Note: The container network is set to 'host' via Docker Compose to share the development machine's network interface.
ENV_ROS_CLIENT_IP=

# Robot hostname for automatic '/etc/hosts' resolution in the Docker container (optional).
# Note: Set to the robot's mDNS hostname (e.g., 'turtlebot3.local') for automatic network discovery via 'avahi-resolve'.
ENV_ROBOT_HOSTNAME=turtlebot3.local

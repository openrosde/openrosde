<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- Configure the TurtleBot3 robots and their initial positions. -->

  <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>
  <arg name="first_tb3"  default="turtlebot3_01"/>
  <arg name="second_tb3" default="turtlebot3_02"/>
  <arg name="third_tb3"  default="turtlebot3_03"/>

  <arg name="first_tb3_x_pos" default="4.0"/>
  <arg name="first_tb3_y_pos" default="9.0"/>
  <arg name="first_tb3_z_pos" default="0.0"/>
  <arg name="first_tb3_yaw"   default="-1.57079633"/>

  <arg name="second_tb3_x_pos" default="-3.0"/>
  <arg name="second_tb3_y_pos" default="10.0"/>
  <arg name="second_tb3_z_pos" default="0.0"/>
  <arg name="second_tb3_yaw"   default="3.14159265"/>

  <arg name="third_tb3_x_pos" default="0.0"/>
  <arg name="third_tb3_y_pos" default="12.0"/>
  <arg name="third_tb3_z_pos" default="0.0"/>
  <arg name="third_tb3_yaw"   default="1.57079633"/>

  <!-- Configure the Gazebo simulation environment. -->

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find aws_robomaker_hospital_world)/worlds/hospital.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn the first TurtleBot3 robot. -->

  <group ns = "$(arg first_tb3)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro laser_visual:=true camera_visual:=true imu_visual:=true"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="publish_frequency" type="double" value="50.0"/>
      <param name="tf_prefix" value="$(arg first_tb3)"/>
    </node>
    
    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-urdf -model $(arg first_tb3) -x $(arg first_tb3_x_pos) -y $(arg first_tb3_y_pos) -z $(arg first_tb3_z_pos) -Y $(arg first_tb3_yaw) -param robot_description"/>
  </group>

  <!-- Spawn the second TurtleBot3 robot. -->

  <group ns = "$(arg second_tb3)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro laser_visual:=true camera_visual:=true imu_visual:=true"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="publish_frequency" type="double" value="50.0"/>
      <param name="tf_prefix" value="$(arg second_tb3)"/>
    </node>

    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-urdf -model $(arg second_tb3) -x $(arg second_tb3_x_pos) -y $(arg second_tb3_y_pos) -z $(arg second_tb3_z_pos) -Y $(arg second_tb3_yaw) -param robot_description"/>
  </group>

  <!-- Spawn the third TurtleBot3 robot. -->

  <group ns = "$(arg third_tb3)">
    <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro laser_visual:=true camera_visual:=true imu_visual:=true"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen">
      <param name="publish_frequency" type="double" value="50.0"/>
      <param name="tf_prefix" value="$(arg third_tb3)"/>
    </node>

    <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-urdf -model $(arg third_tb3) -x $(arg third_tb3_x_pos) -y $(arg third_tb3_y_pos) -z $(arg third_tb3_z_pos) -Y $(arg third_tb3_yaw) -param robot_description"/>
  </group>

  <!-- Run SLAM on each TurtleBot3 robot. -->

  <include file="$(find turtlebot3_gazebo)/launch/multi_turtlebot3_slam.launch">
    <arg name="ns" default="$(arg first_tb3)"/>
  </include>

  <include file="$(find turtlebot3_gazebo)/launch/multi_turtlebot3_slam.launch">
    <arg name="ns" default="$(arg second_tb3)"/>
  </include>

  <include file="$(find turtlebot3_gazebo)/launch/multi_turtlebot3_slam.launch">
    <arg name="ns" default="$(arg third_tb3)"/>
  </include>

  <!-- Merge the map of each TurtleBot3 robot. -->

  <group ns="$(arg first_tb3)/map_merge">
    <param name="init_pose_x"   value="$(arg first_tb3_x_pos)"/>
    <param name="init_pose_y"   value="$(arg first_tb3_y_pos)"/>
    <param name="init_pose_z"   value="$(arg first_tb3_z_pos)"/>
    <param name="init_pose_yaw" value="$(arg first_tb3_yaw)"  />
  </group>

  <group ns="$(arg second_tb3)/map_merge">
    <param name="init_pose_x"   value="$(arg second_tb3_x_pos)"/>
    <param name="init_pose_y"   value="$(arg second_tb3_y_pos)"/>
    <param name="init_pose_z"   value="$(arg second_tb3_z_pos)"/>
    <param name="init_pose_yaw" value="$(arg second_tb3_yaw)"  />
  </group>

  <group ns="$(arg third_tb3)/map_merge">
    <param name="init_pose_x"   value="$(arg third_tb3_x_pos)"/>
    <param name="init_pose_y"   value="$(arg third_tb3_y_pos)"/>
    <param name="init_pose_z"   value="$(arg third_tb3_z_pos)"/>
    <param name="init_pose_yaw" value="$(arg third_tb3_yaw)"  />
  </group>

  <node pkg="multirobot_map_merge" type="map_merge" respawn="false" name="map_merge" output="screen">
    <param name="robot_map_topic" value="map"/>
    <param name="robot_namespace" value="turtlebot3_0"/>
    <param name="merged_map_topic" value="map"/>
    <param name="world_frame" value="map"/>
    <param name="known_init_poses" value="true"/>
    <param name="merging_rate" value="0.5"/>
    <param name="discovery_rate" value="0.05"/>
    <param name="estimation_rate" value="0.1"/>
    <param name="estimation_confidence" value="1.0"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="map_to_odom_tf_broadcaster" args="0 0 0 0 0 0 /map /odom 100"/>
  <node pkg="tf" type="static_transform_publisher" name="odom_to_base_footprint_tf_broadcaster" args="0 0 0 0 0 0 /odom /base_footprint 100"/>

  <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_$(arg first_tb3)_map_tf_broadcaster" args="0 0 0 0 0 0 /base_footprint /$(arg first_tb3)/map 100"/>
  <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_$(arg second_tb3)_map_tf_broadcaster" args="0 0 0 0 0 0 /base_footprint /$(arg second_tb3)/map 100"/>
  <node pkg="tf" type="static_transform_publisher" name="base_footprint_to_$(arg third_tb3)_map_tf_broadcaster" args="0 0 0 0 0 0 /base_footprint /$(arg third_tb3)/map 100"/>

  <node pkg="tf" type="static_transform_publisher" name="$(arg first_tb3)_odom_to_$(arg first_tb3)_base_footprint_tf_broadcaster" args="0 0 0 0 0 0 /$(arg first_tb3)/odom /$(arg first_tb3)/base_footprint 100"/>
  <node pkg="tf" type="static_transform_publisher" name="$(arg second_tb3)_odom_to_$(arg second_tb3)_base_footprint_tf_broadcaster" args="0 0 0 0 0 0 /$(arg second_tb3)/odom /$(arg second_tb3)/base_footprint 100"/>
  <node pkg="tf" type="static_transform_publisher" name="$(arg third_tb3)_odom_to_$(arg third_tb3)_base_footprint_tf_broadcaster" args="0 0 0 0 0 0 /$(arg third_tb3)/odom /$(arg third_tb3)/base_footprint 100"/>

  <!-- Run GUI to manually control each TurtleBot3 robot. -->

  <node name="rqt_robot_steering" pkg="rqt_robot_steering" type="rqt_robot_steering"/>

</launch>

# Panes of the Robotis TurtleBot3 platform for 'RUN-TMUX-SESSION.bash', in the windows 'robot' and 'extra' of the session.
# Each line reads '<layouts> <window> <launch-file> [<arg:=value> ...]', where '<layouts>' is '*' or a comma-separated list such as 'default-gazebo,default-realworld'.
# The panes of the core, such as the FlexBE app and 'rosbridge', come from 'tmux/openrosde.panes'.

default-gazebo     robot  turtlebot3_bringup_default_gazebo.launch
default-gazebo     robot  turtlebot3_rviz_default_gazebo.launch
default-gazebo     robot  turtlebot3_navigation_default_gazebo.launch
default-gazebo     robot  turtlebot3_mapping_default.launch

default-realworld  robot  turtlebot3_rviz_default_realworld.launch
default-realworld  robot  turtlebot3_mapping_default.launch

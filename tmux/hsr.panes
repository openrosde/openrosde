# Panes of the Toyota HSR platform for 'RUN-TMUX-SESSION.bash', in the windows 'robot' and 'extra' of the session.
# Each line reads '<layouts> <window> <launch-file> [<arg:=value> ...]', where '<layouts>' is '*' or a comma-separated list such as 'default-gazebo,default-realworld'.
# The panes of the core, such as the FlexBE app and 'rosbridge', come from 'tmux/openrosde.panes'.

default-gazebo     robot  hsr_bringup_default_gazebo.launch
default-gazebo     robot  hsr_rviz_default.launch
default-gazebo     robot  hsr_moveit_default.launch
default-gazebo     robot  hsr_navigation_default_gazebo.launch

default-realworld  robot  hsr_rviz_default.launch
default-realworld  robot  hsr_moveit_default.launch

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://fetchrobotics.github.io/docs/navigation.html -->

  <arg name="map_file" default="$(find sde_fetch_launch)/config/maps/map.yaml" />

  <include file="$(find fetch_navigation)/launch/fetch_nav.launch">
    <arg name="map_file" value="$(arg map_file)" />
  </include>

</launch>

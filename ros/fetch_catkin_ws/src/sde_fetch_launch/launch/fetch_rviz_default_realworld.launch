<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://fetchrobotics.github.io/docs/ -->
  <!-- Upstream default: $(find fetch_navigation)/config/navigation.rviz -->

  <arg name="rviz_file" default="$(find sde_fetch_launch)/config/rviz/fetch_rviz_default_realworld.rviz" />

  <node name="rviz" pkg="rviz" type="rviz" required="true" args="-d $(arg rviz_file)" />

  <!-- Maximize the RViz window after it opens. -->
  <node name="maximize_rviz" pkg="sde_launch" type="maximize-app-window.bash" args="RViz" />

</launch>

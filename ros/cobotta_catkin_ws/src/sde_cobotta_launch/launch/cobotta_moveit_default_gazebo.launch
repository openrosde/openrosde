<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- "gripper_type": Select from none/parallel/vacuum. -->
  <!-- Note: Use 'none' to match the Gazebo bringup (cobotta_bringup_default_gazebo.launch). -->
  <arg name="gripper_type" default="none" />

  <!-- Load the MoveIt planning context. -->
  <!-- Note: 'load_robot_description' is false because 'denso_cobotta_gazebo.launch' already loads it. -->
  <include file="$(find denso_cobotta_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="false" />
    <arg name="gripper_type" value="$(arg gripper_type)" />
  </include>

  <!-- Launch MoveIt move_group. -->
  <include file="$(find denso_cobotta_moveit_config)/launch/move_group.launch">
    <arg name="publish_monitored_planning_scene" value="true" />
    <arg name="gripper_type" value="$(arg gripper_type)" />
  </include>

</launch>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/DENSORobot/denso_cobotta_ros -->
  <!-- Upstream default: $(find denso_cobotta_moveit_config)/launch/move_group.launch -->

  <!-- "gripper_type": Select from none/parallel/vacuum. -->
  <arg name="gripper_type" default="parallel" />

  <!-- Load the MoveIt planning context. -->
  <!-- Note: 'load_robot_description' is false because 'denso_cobotta_gazebo.launch' already loads it. -->
  <!-- Note: 'gripper_type' is forwarded so the SRDF includes gripper geometry for collision awareness. -->
  <include file="$(find denso_cobotta_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="false" />
    <arg name="gripper_type" value="$(arg gripper_type)" />
  </include>

  <!-- Launch MoveIt move_group. -->
  <!-- Note: 'gripper_type' is hardcoded to 'none' so the arm-only controller config is used in Gazebo. -->
  <!-- The gripper action server (cobotta/gripper_action) only exists on the real robot, not in Gazebo. -->
  <include file="$(find denso_cobotta_moveit_config)/launch/move_group.launch">
    <arg name="publish_monitored_planning_scene" value="true" />
    <arg name="gripper_type" value="none" />
  </include>

</launch>

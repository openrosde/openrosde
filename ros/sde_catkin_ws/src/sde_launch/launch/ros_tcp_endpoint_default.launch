<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/Unity-Technologies/ROS-TCP-Endpoint -->
  <!-- Upstream default: $(find ros_tcp_endpoint)/launch/endpoint.launch -->

  <!-- Start the Unity ROS TCP Endpoint bound to all interfaces on port 10000. -->
  <!-- Unity clients (e.g. coarobo-sightline on Meta Quest) connect to this endpoint over TCP. -->

  <include file="$(find ros_tcp_endpoint)/launch/endpoint.launch">
    <arg name="tcp_ip" value="0.0.0.0" />
    <arg name="tcp_port" value="10000" />
  </include>

</launch>

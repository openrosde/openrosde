<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/FlexBE/flexbe_app -->
  <!-- Upstream default: $(find flexbe_app)/launch/flexbe_full.launch -->

  <!-- Start both FlexBE Behavior Engine and FlexBE App for local behavior execution. -->

  <include file="$(find flexbe_app)/launch/flexbe_full.launch" />

  <!-- Maximize the FlexBE App window after it opens. -->
  <node name="maximize_flexbe" pkg="sde_launch" type="maximize-app-window.bash" args="FlexBE" />

</launch>

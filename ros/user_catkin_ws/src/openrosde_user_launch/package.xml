<package format="2">
  <name>openrosde_user_launch</name>
  <version>1.0.0</version>
  <description>
    The 'openrosde_user_launch' package is the user-overlay entry point for custom ROS launch files.
    It is platform-agnostic and runs on top of any 'OPENROSDE_ROBOT_PLATFORM'.
  </description>
  <maintainer email="user@example.com">OpenRoSDE User</maintainer>

  <license>Apache-2.0</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://github.com/openrosde/openrosde</url>
  <url type="bugtracker">https://github.com/openrosde/openrosde/issues</url>
  <author email="user@example.com">OpenRoSDE User</author>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospy_tutorials</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>

</package>

<package format="2">
  <name>sde_user_launch</name>
  <version>1.0.0</version>
  <description>
    The 'sde_user_launch' package is the user-overlay entry point for custom ROS launch files.
    It is platform-agnostic and runs on top of any 'SDE_ROBOT_PLATFORM'.
  </description>
  <maintainer email="user@example.com">SDE User</maintainer>

  <license>MIT</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://gitlab.com/coarobo/SDE</url>
  <url type="bugtracker">https://gitlab.com/coarobo/SDE/-/issues</url>
  <author email="user@example.com">SDE User</author>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospy_tutorials</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>nodelet</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>topic_tools</exec_depend>

</package>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- SDE-specific: User-overlay launch file for Ultralytics FastSAM (single-shot, class-agnostic -->
  <!-- 'segment everything', no point-grid, much faster than the original SAM's automatic mode). -->
  <!-- Subscribes to a color image topic and publishes a mask-overlay image via 'scripts/seg_fastsam_node.py'. -->
  <!-- https://docs.ultralytics.com/models/fast-sam/ -->

  <!-- Topics. -->
  <arg name="input_topic"  default="/camera/color/image_raw" />
  <arg name="output_topic" default="/segmentation/mask" />

  <!-- REQUIRED when 'passthrough' is false: local path to the FastSAM '.pt' weights file. -->
  <!-- Use the larger variant for best accuracy, e.g. 'FastSAM-x.pt' (vs. the smaller 'FastSAM-s.pt'). -->
  <!-- The default expects the weights copied into the git-ignored 'models/fastsam' folder of this package. -->
  <arg name="weights" default="$(find sde_user_launch)/models/fastsam/FastSAM-x.pt" />
  <arg name="device"  default="cuda" />

  <!-- Inference tuning. -->
  <arg name="imgsz" default="640" />
  <arg name="conf"  default="0.4" />
  <arg name="iou"   default="0.9" />

  <!-- Mask-color stability across frames (see 'MaskTracker' in seg_fastsam_node.py). -->
  <!-- FastSAM re-detects everything from scratch every frame, so without this the same object -->
  <!-- gets a new random color each frame and the overlay flickers. Matches each new mask to the -->
  <!-- most-overlapping mask from recent frames (by IoU) and reuses its color. -->
  <arg name="track_iou_threshold"    default="0.3" />
  <arg name="track_max_missed_frames" default="5" />

  <!-- Inference rate (Hz). The node only runs the model on the latest received frame at this rate. -->
  <!-- Measured ~30+ fps for FastSAM-x on an RTX 3080 Ti, so this defaults high for a real-time demo. -->
  <arg name="rate_hz" default="30.0" />

  <!-- Also publish a JPEG copy on '<output_topic>/compressed', light enough for Coarobo Viewport over rosbridge. -->
  <arg name="publish_compressed" default="false" />
  <arg name="jpeg_quality"       default="80" />

  <!-- Set to 'true' to skip FastSAM entirely and just republish the input as-is (pipeline sanity check). -->
  <arg name="passthrough" default="false" />

  <!-- Whether to start RViz alongside the node. -->
  <arg name="rviz" default="true" />

  <node name="seg_fastsam_node" pkg="sde_user_launch" type="seg_fastsam_node.py" output="screen">
    <param name="input_topic"  value="$(arg input_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="weights" value="$(arg weights)" />
    <param name="device"  value="$(arg device)" />
    <param name="imgsz" value="$(arg imgsz)" />
    <param name="conf"  value="$(arg conf)" />
    <param name="iou"   value="$(arg iou)" />
    <param name="track_iou_threshold"     value="$(arg track_iou_threshold)" />
    <param name="track_max_missed_frames" value="$(arg track_max_missed_frames)" />
    <param name="rate_hz"     value="$(arg rate_hz)" />
    <param name="passthrough" value="$(arg passthrough)" />
    <param name="publish_compressed" value="$(arg publish_compressed)" />
    <param name="jpeg_quality"       value="$(arg jpeg_quality)" />
  </node>

  <node if="$(arg rviz)" name="seg_fastsam_rviz" pkg="rviz" type="rviz"
        args="-d $(find sde_user_launch)/config/rviz/seg_fastsam.rviz" />

</launch>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- OpenRoSDE-specific launch: configures teleop for Gazebo. -->

  <!-- Teleop input source: 'spacemouse' (3Dconnexion SpaceMouse, default), 'viewport' (Coarobo Viewport panel), 'spacemouse_viewport' (both at once), 'sightline' (Coarobo Sightline OpenXR application), or 'spacemouse_viewport_sightline' (all three at once). -->
  <!-- Pass 'input_source:=viewport' to drive from the panel, 'input_source:=spacemouse_viewport' to drive from either, 'input_source:=sightline' to drive from the Meta Quest 3, or 'input_source:=spacemouse_viewport_sightline' to drive from any of the three. -->
  <arg name="input_source" default="spacemouse" />

  <!-- Gazebo controller configuration. -->
  <arg name="controller_mode" default="trajectory" />
  <arg name="command_out_topic" default="$(eval '/joint_group_vel_controller/command' if arg('controller_mode') == 'velocity' else '/eff_joint_traj_controller/command')" />
  <arg name="switch_controllers" default="false" />
  <arg name="controllers_to_start" default="$(eval 'joint_group_vel_controller' if arg('controller_mode') == 'velocity' else 'eff_joint_traj_controller')" />
  <arg name="controllers_to_stop" default="$(eval 'eff_joint_traj_controller' if arg('controller_mode') == 'velocity' else 'joint_group_eff_controller')" />

  <!-- Motion frame configuration. -->
  <!-- Coarobo Sightline grabs the gripper hologram, so the sightline input drives the gripper frame while the other inputs keep the flange. -->
  <!-- With all three inputs, the flange stays, since every input stamps its twists in 'base_link', where the end effector frame does not change how MoveIt Servo applies them. -->
  <arg name="ee_frame_name" default="$(eval 'onrobot_rg2_base_link' if arg('input_source') == 'sightline' else 'flange')" />
  <arg name="robot_link_command_frame" default="base_link" />
  <arg name="frame_id" default="base_link" />

  <!-- SpaceMouse input scaling. -->
  <arg name="require_enable_button" default="true" />
  <arg name="reverse_for_front_view" default="true" />
  <arg name="linear_x_scale" default="2.0" />
  <arg name="linear_y_scale" default="2.0" />
  <arg name="linear_z_scale" default="2.0" />
  <arg name="angular_x_scale" default="4.0" />
  <arg name="angular_y_scale" default="4.0" />
  <arg name="angular_z_scale" default="4.0" />

  <!-- 'pass_all_args' forwards every arg declared above to the teleop stack, so a new parameter only needs to be added in one place. -->
  <include file="$(find openrosde_ur5e_teleop)/launch/ur5e_teleop.launch" pass_all_args="true" />

</launch>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-industrial/universal_robot -->
  <!-- Upstream default: $(find ur_gazebo)/launch/ur5e_bringup.launch -->

  <!-- Resolve the robot description in the package that 'OPENROSDE_UR5E_DESCRIPTION_PACKAGE' names, which defaults to 'openrosde_ur5e_launch'. -->
  <!-- A setup replaces it with its own package, which holds 'urdf/ur5e_<environment>.xacro', 'config/ur5e/ur5e_<environment>.srdf', and 'config/ur5e/ur5e_calibration.yaml'. -->
  <arg name="description_package" default="$(eval optenv('OPENROSDE_UR5E_DESCRIPTION_PACKAGE', '') or 'openrosde_ur5e_launch')" />
  <arg name="description_file" default="$(eval find(arg('description_package')) + '/urdf/ur5e_gazebo.xacro')" />
  <arg name="semantic_description_file" default="$(eval find(arg('description_package')) + '/config/ur5e/ur5e_gazebo.srdf')" />

  <!-- UR5e URDF xacro arguments. -->
  <arg name="joint_limit_params" default="$(find ur_description)/config/ur5e/joint_limits.yaml" />
  <arg name="kinematics_params" default="$(find ur_description)/config/ur5e/default_kinematics.yaml" />
  <arg name="physical_params" default="$(find ur_description)/config/ur5e/physical_parameters.yaml" />
  <arg name="visual_params" default="$(find ur_description)/config/ur5e/visual_parameters.yaml" />
  <arg name="transmission_hw_interface" default="hardware_interface/EffortJointInterface" />
  <arg name="safety_limits" default="false" />
  <arg name="safety_pos_margin" default="0.15" />
  <arg name="safety_k_position" default="20" />

  <!-- Gazebo controller arguments. -->
  <arg name="controller_config_file" default="$(find ur_gazebo)/config/ur5e_controllers.yaml" />
  <arg name="controllers" default="joint_state_controller eff_joint_traj_controller" />
  <arg name="stopped_controllers" default="joint_group_eff_controller" />

  <!-- Gazebo simulation arguments. -->
  <arg name="tf_prefix" default="" />
  <arg name="tf_pub_rate" default="500" />
  <arg name="paused" default="false" />
  <arg name="gui" default="true" />
  <arg name="gazebo_model_name" default="robot" />
  <arg name="gazebo_world" default="worlds/empty.world" />
  <arg name="robot_description_param_name" default="robot_description" />
  <arg name="spawn_z" default="0.1" />
  <arg name="start_gazebo" default="true" />
  <arg name="initial_joint_positions" default=" -J shoulder_pan_joint 0.0 -J shoulder_lift_joint 0.0 -J elbow_joint 0.0 -J wrist_1_joint 0.0 -J wrist_2_joint 0.0 -J wrist_3_joint 0.0" />

  <!-- Load the robot description, SRDF, and kinematics config. -->
  <param name="robot_description" command="$(find xacro)/xacro '$(arg description_file)'
    robot_model:=ur5e
    joint_limit_params:=$(arg joint_limit_params)
    kinematics_params:=$(arg kinematics_params)
    physical_params:=$(arg physical_params)
    visual_params:=$(arg visual_params)
    transmission_hw_interface:=$(arg transmission_hw_interface)
    safety_limits:=$(arg safety_limits)
    safety_pos_margin:=$(arg safety_pos_margin)
    safety_k_position:=$(arg safety_k_position)" />

  <param name="robot_description_semantic" textfile="$(arg semantic_description_file)" />

  <group ns="robot_description_kinematics">
    <rosparam command="load" file="$(find ur5e_moveit_config)/config/kinematics.yaml" />
  </group>

  <!-- Start 'robot_state_publisher' and Gazebo simulation. -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="$(arg tf_pub_rate)" />
    <param name="tf_prefix" value="$(arg tf_prefix)" />
  </node>

  <include file="$(find ur_gazebo)/launch/inc/ur_control.launch.xml">
    <arg name="controller_config_file" value="$(arg controller_config_file)" />
    <arg name="controllers" value="$(arg controllers)" />
    <arg name="stopped_controllers" value="$(arg stopped_controllers)" />
    <arg name="gazebo_model_name" value="$(arg gazebo_model_name)" />
    <arg name="gazebo_world" value="$(arg gazebo_world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)" />
    <arg name="robot_description_param_name" value="$(arg robot_description_param_name)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="start_gazebo" value="$(arg start_gazebo)" />
    <arg name="initial_joint_positions" value="$(arg initial_joint_positions)" />
  </include>

  <!-- Maximize the Gazebo window after it opens. -->
  <node name="maximize_gazebo" pkg="openrosde_launch" type="maximize-app-window.bash" args="Gazebo" />

</launch>

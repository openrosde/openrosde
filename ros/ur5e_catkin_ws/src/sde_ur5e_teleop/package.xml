<package format="2">
  <name>sde_ur5e_teleop</name>
  <version>1.0.0</version>
  <description>
    The 'sde_ur5e_teleop' package enables teleoperation of a Universal Robots UR5e equipped with an OnRobot RG2 gripper using a 3Dconnexion SpaceMouse.
  </description>
  <maintainer email="lotfi@coarobo.com">Lotfi El Hafi</maintainer>
  <author email="lotfi@coarobo.com">Lotfi El Hafi</author>

  <license>MIT</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://gitlab.com/coarobo/SDE</url>
  <url type="bugtracker">https://gitlab.com/coarobo/SDE/-/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>onrobot_rg_control</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>nodelet</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>spacenav_node</exec_depend>
  <exec_depend>topic_tools</exec_depend>
</package>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <arg name="launch_spacenav_node" default="true" />
  <arg name="input_twist_topic" default="/spacenav/twist" />
  <arg name="output_twist_topic" default="/servo_server/delta_twist_cmds" />
  <arg name="joy_topic" default="/spacenav/joy" />
  <arg name="frame_id" default="flange" />

  <arg name="require_enable_button" default="true" />
  <arg name="enable_button_index" default="0" />
  <arg name="publish_zero_when_disabled" default="true" />
  <arg name="enable_gripper_button" default="true" />
  <arg name="gripper_button_index" default="1" />
  <arg name="gripper_service_name" default="/onrobot_rg/set_command" />
  <arg name="gripper_open_command" default="o" />
  <arg name="gripper_close_command" default="c" />
  <arg name="gripper_initial_state" default="open" />

  <arg name="linear_x_scale" default="1.0" />
  <arg name="linear_y_scale" default="1.0" />
  <arg name="linear_z_scale" default="1.0" />
  <arg name="angular_x_scale" default="1.0" />
  <arg name="angular_y_scale" default="1.0" />
  <arg name="angular_z_scale" default="1.0" />
  <arg name="publish_rate" default="100.0" />
  <arg name="input_timeout" default="0.1" />
  <arg name="linear_deadband" default="0.10" />
  <arg name="angular_deadband" default="0.10" />
  <arg name="linear_smoothing_time_constant" default="0.08" />
  <arg name="angular_smoothing_time_constant" default="0.08" />
  <arg name="max_linear_acceleration" default="4.0" />
  <arg name="max_angular_acceleration" default="6.0" />

  <include file="$(find spacenav_node)/launch/classic.launch" if="$(arg launch_spacenav_node)" />

  <node pkg="sde_ur5e_teleop"
    type="ur5e_spacenav_node_moveit_servo.py"
    name="ur5e_spacenav_node_moveit_servo"
    output="screen">
    <param name="input_twist_topic" value="$(arg input_twist_topic)" />
    <param name="output_twist_topic" value="$(arg output_twist_topic)" />
    <param name="joy_topic" value="$(arg joy_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="require_enable_button" value="$(arg require_enable_button)" />
    <param name="enable_button_index" value="$(arg enable_button_index)" />
    <param name="publish_zero_when_disabled" value="$(arg publish_zero_when_disabled)" />
    <param name="linear_x_scale" value="$(arg linear_x_scale)" />
    <param name="linear_y_scale" value="$(arg linear_y_scale)" />
    <param name="linear_z_scale" value="$(arg linear_z_scale)" />
    <param name="angular_x_scale" value="$(arg angular_x_scale)" />
    <param name="angular_y_scale" value="$(arg angular_y_scale)" />
    <param name="angular_z_scale" value="$(arg angular_z_scale)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="input_timeout" value="$(arg input_timeout)" />
    <param name="linear_deadband" value="$(arg linear_deadband)" />
    <param name="angular_deadband" value="$(arg angular_deadband)" />
    <param name="linear_smoothing_time_constant" value="$(arg linear_smoothing_time_constant)" />
    <param name="angular_smoothing_time_constant" value="$(arg angular_smoothing_time_constant)" />
    <param name="max_linear_acceleration" value="$(arg max_linear_acceleration)" />
    <param name="max_angular_acceleration" value="$(arg max_angular_acceleration)" />
  </node>

  <node pkg="sde_ur5e_teleop"
    type="ur5e_spacenav_node_onrobot_rg_control.py"
    name="ur5e_spacenav_node_onrobot_rg_control"
    output="screen"
    if="$(arg enable_gripper_button)">
    <param name="joy_topic" value="$(arg joy_topic)" />
    <param name="gripper_button_index" value="$(arg gripper_button_index)" />
    <param name="gripper_service_name" value="$(arg gripper_service_name)" />
    <param name="gripper_open_command" value="$(arg gripper_open_command)" />
    <param name="gripper_close_command" value="$(arg gripper_close_command)" />
    <param name="gripper_initial_state" value="$(arg gripper_initial_state)" />
  </node>

</launch>

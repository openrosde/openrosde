<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- SDE-specific launch: runs 'ur5e_viewport_moveit_servo.py', which bridges -->
  <!-- the viewport 'Twist' stream to MoveIt Servo 'TwistStamped' commands. -->

  <arg name="input_twist_topic" default="/cmd_vel" />
  <arg name="output_twist_topic" default="/servo_server/delta_twist_cmds" />
  <arg name="frame_id" default="base_link" />
  <arg name="publish_rate" default="100.0" />
  <arg name="input_timeout" default="0.2" />
  <arg name="smoothing_alpha" default="0.1" />

  <node pkg="sde_ur5e_teleop"
        type="ur5e_viewport_moveit_servo.py"
        name="ur5e_viewport_moveit_servo"
        output="screen">
    <param name="input_twist_topic" value="$(arg input_twist_topic)" />
    <param name="output_twist_topic" value="$(arg output_twist_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="input_timeout" value="$(arg input_timeout)" />
    <param name="smoothing_alpha" value="$(arg smoothing_alpha)" />
  </node>

</launch>

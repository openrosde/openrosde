<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-teleop/twist_modifier -->
  <!-- SDE-specific launch: runs 'twist_to_stamped.py' for viewport teleoperation. -->

  <node pkg="twist_modifier"
        type="twist_to_stamped.py"
        name="ur5e_viewport_teleop"
        output="screen" />

</launch>

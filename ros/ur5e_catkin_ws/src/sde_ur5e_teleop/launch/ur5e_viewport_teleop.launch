<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-teleop/twist_modifier -->
  <!-- SDE-specific launch: runs 'ur5e_viewport_teleop_node.py' for viewport teleoperation. -->

  <node pkg="sde_ur5e_teleop"
        type="ur5e_viewport_teleop_node.py"
        name="ur5e_viewport_teleop_node"
        output="screen" />

</launch>

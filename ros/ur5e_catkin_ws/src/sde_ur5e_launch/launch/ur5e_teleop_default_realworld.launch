<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- SDE-specific launch: configures teleop for the realworld robot. -->

  <!-- Teleop input source: 'spacemouse' (3Dconnexion SpaceMouse, default) or 'viewport' (Coarobo Viewport panel). -->
  <!-- Pass 'input_source:=viewport' to drive from the panel. -->
  <arg name="input_source" default="viewport" />

  <!-- Real-world controller configuration. -->
  <arg name="controller_mode" default="trajectory" />
  <arg name="command_out_topic" default="$(eval '/joint_group_vel_controller/command' if arg('controller_mode') == 'velocity' else '/scaled_pos_joint_traj_controller/command')" />
  <arg name="switch_controllers" default="true" />
  <arg name="controllers_to_start" default="$(eval 'joint_group_vel_controller' if arg('controller_mode') == 'velocity' else 'scaled_pos_joint_traj_controller')" />
  <arg name="controllers_to_stop" default="$(eval 'scaled_pos_joint_traj_controller' if arg('controller_mode') == 'velocity' else 'joint_group_vel_controller')" />

  <!-- SpaceMouse motion frame configuration. -->
  <arg name="ee_frame_name" default="flange" />
  <arg name="robot_link_command_frame" default="base_link" />
  <arg name="frame_id" default="base_link" />

  <!-- SpaceMouse input scaling. -->
  <arg name="require_enable_button" default="true" />
  <arg name="reverse_for_front_view" default="true" />
  <arg name="linear_x_scale" default="2.0" />
  <arg name="linear_y_scale" default="2.0" />
  <arg name="linear_z_scale" default="2.0" />
  <arg name="angular_x_scale" default="4.0" />
  <arg name="angular_y_scale" default="4.0" />
  <arg name="angular_z_scale" default="4.0" />

  <!-- 'pass_all_args' forwards every arg declared above to the teleop stack, so a new parameter only needs to be added in one place. -->
  <include file="$(find sde_ur5e_teleop)/launch/ur5e_teleop.launch" pass_all_args="true" />

</launch>

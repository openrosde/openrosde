<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-industrial/universal_robot -->

  <arg name="sim" default="false" />

  <include file="$(find ur5e_moveit_config)/launch/moveit_planning_execution.launch">
    <arg name="sim" value="$(arg sim)" />
  </include>

  <group ns="robot_description_planning">
    <rosparam command="load" file="$(find coarobo_teleop)/config/ur5e_joint_limits.yaml" />
  </group>

  <!-- This remap is necessary for MoveIt to interface with the UR5e driver. -->
  <remap from="/follow_joint_trajectory" to="/scaled_pos_joint_traj_controller/follow_joint_trajectory" />

</launch>

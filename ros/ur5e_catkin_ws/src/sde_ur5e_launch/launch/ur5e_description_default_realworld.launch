<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- SDE-specific adapter called by 'ur_robot_driver' via the 'robot_description_file' arg. -->
  <!-- Accepts 'kinematics_params' so the robot calibration YAML is passed through to xacro. -->
  <arg name="kinematics_params" />

  <!-- External RealSense D435i camera position arguments. -->
  <!-- These default to the 'SDE_UR5E_EXTERNAL_CAMERA_*' environment variables. -->
  <arg name="external_camera_x"     default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_X 0)" />
  <arg name="external_camera_y"     default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_Y -0.254)" />
  <arg name="external_camera_z"     default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_Z 0.38)" />
  <arg name="external_camera_roll"  default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_ROLL 0)" />
  <arg name="external_camera_pitch" default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_PITCH 0.31)" />
  <arg name="external_camera_yaw"   default="$(optenv SDE_UR5E_EXTERNAL_CAMERA_YAW 2.60159)" />

  <param name="robot_description"
    command="$(find xacro)/xacro '$(find sde_ur5e_launch)/urdf/ur5e_realworld.xacro'
      kinematics_params:=$(arg kinematics_params)
      external_camera_x:=$(arg external_camera_x)
      external_camera_y:=$(arg external_camera_y)
      external_camera_z:=$(arg external_camera_z)
      external_camera_roll:=$(arg external_camera_roll)
      external_camera_pitch:=$(arg external_camera_pitch)
      external_camera_yaw:=$(arg external_camera_yaw)" />

</launch>

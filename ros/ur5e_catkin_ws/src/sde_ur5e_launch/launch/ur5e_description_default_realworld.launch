<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- Called by ur_common.launch via the robot_description_file arg.
       Accepts kinematics_params so the robot's calibration YAML is passed through. -->
  <arg name="kinematics_params" />

  <param name="robot_description"
    command="$(find xacro)/xacro '$(find sde_ur5e_launch)/urdf/ur5e_realworld.xacro'
      kinematics_params:=$(arg kinematics_params)" />

</launch>

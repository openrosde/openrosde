<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-industrial/universal_robot -->
  <!-- Upstream default: $(find ur5e_moveit_config)/launch/moveit.rviz -->

  <node pkg="rviz" type="rviz" name="rviz" required="true"
    args="-d $(find sde_ur5e_launch)/config/rviz/ur5e_rviz_default_gazebo.rviz" />

</launch>

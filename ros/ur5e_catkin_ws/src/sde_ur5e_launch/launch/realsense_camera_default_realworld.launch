<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/realsenseai/realsense-ros -->
  <!-- Upstream default: $(find realsense2_camera)/launch/rs_multiple_devices.launch -->

  <!-- Enable pointcloud filter on both cameras. -->
  <arg name="filters" default="pointcloud" />

  <!-- Wrist-mounted RealSense D435i camera. -->
  <!-- The 'camera1' name must match the URDF frame prefix ('wrist_camera_*_optical_frame'). -->
  <arg name="serial_no_camera1" default="000000000000" />
  <arg name="camera1"           default="wrist_camera" />

  <!-- External RealSense D435i camera. -->
  <!-- The 'camera2' name must match the URDF frame prefix ('external_camera_*_optical_frame'). -->
  <arg name="serial_no_camera2" default="000000000001" />
  <arg name="camera2"           default="external_camera" />

  <!-- TF publishing from the driver is left at the upstream default. -->
  <!-- 'robot_state_publisher' already provides the static camera-to-'base_link' transform from the URDF. -->
  <include file="$(find realsense2_camera)/launch/rs_multiple_devices.launch">

    <!-- Wrist-mounted camera. -->
    <arg name="serial_no_camera1" value="$(arg serial_no_camera1)" />
    <arg name="camera1"           value="$(arg camera1)" />

    <!-- External camera. -->
    <arg name="serial_no_camera2" value="$(arg serial_no_camera2)" />
    <arg name="camera2"           value="$(arg camera2)" />

    <arg name="filters" value="$(arg filters)" />
  </include>

</launch>

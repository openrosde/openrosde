<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/UniversalRobots/Universal_Robots_ROS_Driver -->
  <!-- Upstream default: $(find ur_robot_driver)/launch/ur5e_bringup.launch -->

  <!-- Resolve the robot description in the package that 'SDE_UR5E_DESCRIPTION_PACKAGE' names, which defaults to 'sde_ur5e_launch'. -->
  <!-- A setup replaces it with its own package, which holds 'urdf/ur5e_<environment>.xacro', 'config/ur5e/ur5e_<environment>.srdf', and 'config/ur5e/ur5e_calibration.yaml'. -->
  <arg name="description_package" default="$(eval optenv('SDE_UR5E_DESCRIPTION_PACKAGE', '') or 'sde_ur5e_launch')" />
  <arg name="semantic_description_file" default="$(eval find(arg('description_package')) + '/config/ur5e/ur5e_realworld.srdf')" />

  <arg name="robot_ip" default="$(optenv SDE_UR5E_TEACH_PENDANT_IP)" />
  <arg name="kinematics_config" default="$(eval find(arg('description_package')) + '/config/ur5e/ur5e_calibration.yaml')" />
  <arg name="headless_mode" default="true" />

  <!-- Load the SRDF so RViz (with MoveIt plugin) works independently of 'move_group'. -->
  <param name="robot_description_semantic" textfile="$(arg semantic_description_file)" />

  <!-- Load kinematics config so RViz does not warn about missing kinematics plugins. -->
  <group ns="robot_description_kinematics">
    <rosparam command="load" file="$(find ur5e_moveit_config)/config/kinematics.yaml" />
  </group>

  <include file="$(find ur_robot_driver)/launch/ur5e_bringup.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
    <arg name="kinematics_config" value="$(arg kinematics_config)" />
    <arg name="headless_mode" value="$(arg headless_mode)" />
    <arg name="robot_description_file" value="$(find sde_ur5e_launch)/launch/ur5e_description_default_realworld.launch" />
  </include>

  <!-- Publish live OnRobot RG2 gripper joint states from '/OnRobotRGInput' to '/joint_states'. -->
  <!-- 'robot_state_publisher' needs these to compute TF for all gripper links. -->
  <node name="gripper_joint_state_publisher" pkg="sde_ur5e_launch"
    type="publish-gripper-joint-states.py" output="screen" />

</launch>

<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="picknik_camera_adapter" params="parent *origin">

    <!-- Joint connecting the adapter to the parent link (e.g., tool0) -->
    <joint name="camera_adapter_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="camera_adapter_link" />
    </joint>

    <!-- The adapter link itself -->
    <link name="camera_adapter_link">
      <!-- Inertial properties (estimated for a small 3D printed plastic adapter) -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.050" />
        <inertia ixx="1.0e-5" ixy="0" ixz="0" iyy="1.0e-5" iyz="0" izz="1.0e-5" />
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://sde_ur5e_launch/description/picknik_ur5_realsense_camera_adapter/meshes/picknik_ur5_realsense_camera_adapter.stl" scale="1 1 1" />
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1" />
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://sde_ur5e_launch/description/picknik_ur5_realsense_camera_adapter/meshes/picknik_ur5_realsense_camera_adapter.stl" scale="1 1 1" />
        </geometry>
      </collision>
    </link>

    <!-- Tool/Mount frame: this is a convenience frame where the camera actually attaches to the mount -->
    <joint name="camera_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="camera_adapter_link" />
      <child link="camera_mount_link" />
    </joint>
    <link name="camera_mount_link" />

  </xacro:macro>
</robot>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <arg name="planning_frame" default="base_link" />
  <arg name="ee_frame_name" default="flange" />
  <arg name="robot_link_command_frame" default="flange" />
  <arg name="command_out_topic" default="/scaled_pos_joint_traj_controller/command" />
  <arg name="servo_config_file" default="$(find coarobo_teleop)/config/ur5e_moveit_servo_trajectory.yaml" />

  <include file="$(find coarobo_teleop)/launch/ur5e_moveit_servo_velocity.launch">
    <arg name="planning_frame" value="$(arg planning_frame)" />
    <arg name="ee_frame_name" value="$(arg ee_frame_name)" />
    <arg name="robot_link_command_frame" value="$(arg robot_link_command_frame)" />
    <arg name="command_out_topic" value="$(arg command_out_topic)" />
    <arg name="servo_config_file" value="$(arg servo_config_file)" />
    <arg name="command_out_type" value="trajectory_msgs/JointTrajectory" />
    <arg name="publish_joint_positions" value="true" />
    <arg name="publish_joint_velocities" value="false" />
    <arg name="switch_controllers" value="true" />
    <arg name="controllers_to_start" value="scaled_pos_joint_traj_controller" />
    <arg name="controllers_to_stop" value="joint_group_vel_controller" />
  </include>

</launch>

<package>
  <name>coarobo_teleop</name>
  <version>1.0.0</version>
  <description>
    The 'coarobo_teleop' package enables teleoperation of a Universal Robots UR5e equipped with an OnRobot RG2 gripper using a 3Dconnexion SpaceMouse.
  </description>
  <maintainer email="lotfi@coarobo.com">Lotfi El Hafi</maintainer>
  <author email="lotfi@coarobo.com">Lotfi El Hafi</author>

  <license>Copyright (c) 2026 Coarobo GK</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://gitlab.com/emlab/UR5e</url>
  <url type="bugtracker">https://gitlab.com/emlab/UR5e/-/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>onrobot_rg_control</build_depend>
  <build_depend>controller_manager_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <run_depend>controller_manager_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>moveit_servo</run_depend>
  <run_depend>onrobot_rg_control</run_depend>
  <run_depend>rospy</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>spacenav_node</run_depend>
  <run_depend>std_msgs</run_depend>
</package>

<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ROBOTIS-GIT/turtlebot3 -->
  <!-- Upstream default: $(find turtlebot3_gazebo)/rviz/turtlebot3_gazebo_rviz.rviz -->

  <!-- Relay the Gazebo camera topic to the standard real-robot camera topic name used in the RViz config ('topic_tools/relay' copies the raw message without re-publishing via 'image_transport', so the relayed topic has no 'compressed' sub-topic). -->
  <node pkg="topic_tools" type="relay" name="relay_camera"
    args="/camera/rgb/image_raw /raspicam_node/image" />

  <!-- Display Rviz with a custom layout to monitor the TurtleBot3 robot. -->

  <node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find openrosde_turtlebot3_launch)/config/rviz/turtlebot3_rviz_default.rviz" />

  <!-- Maximize the RViz window after it opens. -->
  <node name="maximize_rviz" pkg="openrosde_launch" type="maximize-app-window.bash" args="RViz" />

</launch>

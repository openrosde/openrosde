<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ROBOTIS-GIT/turtlebot3 -->
  <!-- Upstream default: $(find turtlebot3_slam)/launch/turtlebot3_slam.launch -->

  <!-- Start mapping on the TurtleBot3 robot. -->

  <include file="$(find turtlebot3_slam)/launch/turtlebot3_slam.launch">
    <arg name="slam_methods" value="gmapping" doc="slam type [gmapping, cartographer, hector, karto, frontier_exploration]" />
    <arg name="configuration_basename" value="turtlebot3_lds_2d.lua" />
    <arg name="open_rviz" value="false" />
  </include>

</launch>

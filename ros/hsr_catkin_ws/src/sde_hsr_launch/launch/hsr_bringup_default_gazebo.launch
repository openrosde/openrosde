<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/hsr-project/tmc_wrs_binary -->
  <!-- Mirrors wrs_practice0.launch but calls hsrb_empty_world.launch directly
       so we can set use_oss_stacks=true.
       use_oss_stacks=true switches omni_base_controller to use the public
       velocity_controllers/JointTrajectoryController instead of the private
       hsrb_base_controllers/OmniBaseController (not in the binary distribution). -->

  <arg name="paused"       default="false" />
  <arg name="fast_physics" default="false" />
  <arg name="gui"          default="true" />
  <arg name="rviz"         default="false" />
  <arg name="map"          default="$(find tmc_wrs_gazebo_worlds)/maps/wrs2020/map.yaml" />
  <arg name="world_name"   default="$(find tmc_wrs_gazebo_worlds)/worlds/wrs2020.world" />
  <arg name="robot_pos"    default="-x -2.1 -y 1.2 -z 0 -Y -1.57" />

  <!-- Spawn the HSR in the WRS 2020 Gazebo world with open-source controllers.
       use_oss_stacks=true:  omni_base_controller uses velocity_controllers (public).
       use_laser_odom=false: wheel odometry from offset_diff_drive_controller. -->
  <include file="$(find hsrb_gazebo_bringup)/launch/hsrb_empty_world.launch">
    <arg name="gui"           value="$(arg gui)" />
    <arg name="paused"        value="$(arg paused)" />
    <arg name="fast_physics"  value="$(arg fast_physics)" />
    <arg name="world_name"    value="$(arg world_name)" />
    <arg name="robot_pos"     value="$(arg robot_pos)" />
    <arg name="use_oss_stacks"   value="true" />
    <arg name="use_laser_odom"   value="false" />
  </include>

  <!-- MoveIt motion planning. -->
  <include file="$(find hsrb_moveit_config)/launch/hsrb_demo_with_controller.launch">
    <arg name="use_gui"               value="false" />
    <arg name="load_robot_description" value="false" />
  </include>

  <!-- Navigation stack (move_base + costmaps). -->
  <include file="$(find hsrb_rosnav_config)/launch/hsrb_nav.launch">
    <arg name="map_file" value="$(arg map)" />
  </include>

  <!-- Relay wheel odometry to the /hsrb/odom topic expected by the nav stack. -->
  <node pkg="topic_tools" type="relay" name="odom_relay"
        args="/hsrb/wheel_odom /hsrb/odom" />

  <!-- Spawn WRS 2020 competition objects into the world. -->
  <node pkg="tmc_wrs_gazebo_worlds" type="spawn_objects" name="spawn_objects"
        args="--seed 1" output="screen" />

  <!-- Maximize the Gazebo window after it opens. -->
  <node if="$(arg gui)" name="maximize_gazebo" pkg="sde_launch"
        type="maximize-app-window.bash" args="Gazebo" />

</launch>


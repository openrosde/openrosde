<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/hsr-project/tmc_wrs_binary -->
  <!-- Upstream default: $(find hsrb_rosnav_config)/launch/hsrb.rviz -->
  <!-- OpenRoSDE-specific: uses a local copy with 'Fullscreen: false' set under 'Window Geometry'. -->

  <!-- Display RViz with the OpenRoSDE-owned HSR navigation and MoveIt layout. -->
  <node name="rviz" pkg="rviz" type="rviz" required="true"
        args="-d $(find openrosde_hsr_launch)/config/rviz/hsr_rviz_default.rviz" />

  <!-- Maximize the RViz window after it opens. -->
  <node name="maximize_rviz" pkg="openrosde_launch" type="maximize-app-window.bash" args="RViz" />

</launch>

# This file documents the user-overlay environment variables.
# It is a reference template: it is NOT auto-loaded by 'SWITCH-ROBOT-PLATFORM.bash'.
#
# To override these defaults:
#   1. Edit '.env.custom' (created by 'SWITCH-ROBOT-PLATFORM.bash') and add your 'OPENROSDE_USER_*' lines below the platform section.
#   2. To expose a new variable to the container, also add it to 'docker/docker-compose-user.yaml' under 'services.openrosde.environment'.
#      'scripts/load-openrosde-env.bash' exports every 'OPENROSDE_*' variable, so Docker Compose can interpolate it.
#
# Usage: edit '.env.custom' (do not source this file directly).

################################################################################

# User overlay configuration.

# Example user-defined variable.
OPENROSDE_USER_EXAMPLE_VAR=user-example-value

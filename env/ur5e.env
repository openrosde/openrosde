# This file contains the default environment variables for the Universal Robots UR5e platform.
# The '.env.custom' file overrides the default variables defined in the '.env' file.
# The '.env.custom' file is ignored by Git to prevent user-specific settings from being committed.
#
# Usage: bash ./SWITCH-ROBOT-PLATFORM.bash ur5e

################################################################################

# SDE configuration.

# Platform to use, among those that 'bash ./SWITCH-ROBOT-PLATFORM.bash' lists when run without an argument.
SDE_ROBOT_PLATFORM=ur5e

# Root directory of the SDE repository inside the Docker container.
# Note: This path is used by the Docker volume mount and all container scripts.
SDE_CONTAINER_ROOT_DIR=/root/SDE

# Extensions to add beside the platform, as space-separated names of the folders cloned into 'extensions/', in the order their Catkin workspaces are built.
# Note: A platform that lives in an extension is found by its name, so its folder needs no entry here.
SDE_ROBOT_EXTENSIONS=

################################################################################

# ROS configuration.

# Host name or IP address of the machine running the ROS master.
# Note: Usually the robot's host name or IP address if remote, or 'localhost' if local (e.g., when running a simulation on Gazebo).
SDE_ROS_MASTER_HOSTNAME=localhost

# IP address of the development machine (i.e., this machine running the container).
# Note: The container network is set to 'host' via Docker Compose to share the development machine's network interface.
SDE_ROS_CLIENT_IP=

# Robot hostname for automatic '/etc/hosts' resolution in the Docker container (optional).
# Note: The Universal Robots UR5e does not support mDNS, so this should be left empty.
SDE_ROBOT_HOSTNAME=

################################################################################

# UR5e platform configuration.

# IP address of the Universal Robots UR5e Teach Pendant.
SDE_UR5E_TEACH_PENDANT_IP=192.168.1.200

# IP address of the OnRobot Compute Box (gripper controller).
SDE_ONROBOT_COMPUTE_BOX_IP=192.168.1.201

################################################################################

# Intel RealSense camera configuration.

# Whether to start the external Intel RealSense D435i camera at bringup.
# Note: Set to 'false' if the external camera is not connected.
SDE_UR5E_ENABLE_EXTERNAL_CAMERA=true

# Serial number of the wrist-mounted Intel RealSense D435 camera.
# Note: Run 'rs-enumerate-devices' to find the serial number of each connected camera.
SDE_UR5E_WRIST_CAMERA_SERIAL_NO=000000000000

# Serial number of the external Intel RealSense D435i camera.
# Note: Run 'rs-enumerate-devices' to find the serial number of each connected camera.
SDE_UR5E_EXTERNAL_CAMERA_SERIAL_NO=000000000001

# Position (x, y, z in meters) of the external Intel RealSense D435i camera in the 'world' frame.
# Note: Measure or calibrate from the robot base after mounting the camera stand.
SDE_UR5E_EXTERNAL_CAMERA_X=-0.10
SDE_UR5E_EXTERNAL_CAMERA_Y=0.35
SDE_UR5E_EXTERNAL_CAMERA_Z=0.10

# Orientation (roll, pitch, yaw in radians) of the external Intel RealSense D435i camera in the 'world' frame.
SDE_UR5E_EXTERNAL_CAMERA_ROLL=0
SDE_UR5E_EXTERNAL_CAMERA_PITCH=0
SDE_UR5E_EXTERNAL_CAMERA_YAW=-2.35619

################################################################################

# User overlay configuration.
# Override these in '.env.custom' to expose your own values to the user-devel container.
# These variables are interpolated by 'docker/docker-compose-user.yaml'.

# Example user-defined variable.
SDE_USER_EXAMPLE_VAR=user-example-value

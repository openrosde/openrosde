# This file holds the settings of ROS 2 in OpenRoSDE, which the template of every platform on ROS 2 repeats, and with which the CI tests the core alone on ROS 2.
# It declares no platform and no setup, so it is never listed and cannot be selected.
# Keep 'OPENROSDE_ROS_DISTRO' the distribution of 'docker/openrosde-base-ros2/Dockerfile', as 'docs/ros2.md' describes.

################################################################################

# ROS configuration.

# Version of ROS that the platform runs, '1' or '2'.
OPENROSDE_ROS_VERSION=2

# Distribution of ROS that the base image 'openrosde-base-ros2' installs in '/opt/ros/<distribution>'.
OPENROSDE_ROS_DISTRO=lyrical

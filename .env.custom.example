# This file contains the user's environment-specific configuration variables.
#
# Usage:
# - Rename this template file to '.env.custom' to be sourced by the SDE scripts.
# - The '.env.custom' file is intended to override or extend the default environment variables defined in the '.env' file.
# - To use the '.env.custom' file, ensure it is sourced after the '.env' file in your scripts or terminal session.
# - Only source the '.env.custom' file if it exists to prevent errors in environments where it may not be present.
# - The '.env.custom' file should be added to '.gitignore' to prevent it from being committed to version control.

################################################################################

# Platform to use: turtlebot3, ur5e
SDE_PLATFORM=${SDE_PLATFORM}

# Root directory of the SDE repository inside the Docker container.
SDE_CONTAINER_ROOT_DIR=${SDE_CONTAINER_ROOT_DIR}

################################################################################

# ROS configuration.

# Host name or IP address of the machine running the ROS master.
# Note: Usually the robot's host name or IP address if remote, or 'localhost' if local (e.g., when running a simulation on Gazebo).
SDE_ROS_MASTER_HOSTNAME=${SDE_ROS_MASTER_HOSTNAME} # Ex: ur5e.local

# IP address of the development machine (i.e., this machine running the container).
# Note: The container network is set to 'host' via Docker Compose to share the development machine's network interface.
SDE_ROS_CLIENT_IP=${SDE_ROS_CLIENT_IP} # Ex: 192.168.1.111

# Robot hostname for automatic '/etc/hosts' resolution in the Docker container (optional).
SDE_ROBOT_HOSTNAME=${SDE_ROBOT_HOSTNAME}

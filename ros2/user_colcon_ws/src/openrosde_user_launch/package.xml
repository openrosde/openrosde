<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openrosde_user_launch</name>
  <version>1.0.0</version>
  <description>
    The 'openrosde_user_launch' package is the user-overlay entry point for custom ROS 2 launch files.
    It is platform-agnostic and runs on top of any 'OPENROSDE_ROBOT_PLATFORM' on ROS 2.
  </description>
  <maintainer email="user@example.com">OpenRoSDE User</maintainer>

  <license>Apache-2.0</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://github.com/openrosde/openrosde</url>
  <url type="bugtracker">https://github.com/openrosde/openrosde/issues</url>
  <author email="user@example.com">OpenRoSDE User</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>demo_nodes_cpp</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
